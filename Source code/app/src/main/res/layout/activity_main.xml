<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText android:id="@+id/editSoPhong" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Số phòng" />
        <EditText android:id="@+id/editGiaPhong" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Giá phòng" android:inputType="number" />
        <EditText android:id="@+id/editDienMoi" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Chỉ số điện mới" android:inputType="number" />
        <EditText android:id="@+id/editDienCu" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Chỉ số điện cũ" android:inputType="number" />
        <EditText android:id="@+id/editGiaDien" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Giá điện (đ/số)" android:inputType="number" />

        <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Thêm / Sửa Phòng" android:onClick="Save" />
        <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Xóa Phòng" android:onClick="Delete" />
        <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Xem Danh Sách" android:onClick="Display" />

    </LinearLayout>
</ScrollView>
